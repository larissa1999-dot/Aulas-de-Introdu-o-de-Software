import java.util.Scanner;
public class Aprovado{
    public static void main(String[] args) {
Scanner sc = new Scanner(System.in);
System.out.print("Qual a primeira nota? ");
double nota1 = sc.nextDouble();
System.out.print("Qual a segunda nota? ");
double nota2 = sc.nextDouble();
double média = (nota1+nota2)/2;
System.out.print("Quantas faltas o aluno teve? ");
double faltas = sc.nextDouble();
boolean aprovado = (média>=6.0)&&(faltas<=9.0);
System.out.println("O aluno foi aprovado? " + aprovado);
sc.close();}}
